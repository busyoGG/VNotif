<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      三个主题变体只有 parent 不同，窗口色一律引用语义色（@color 自己会按 night 限定符切换）：
        values/            API 26-28 浅色系统 → Light
        values-night/      API 26-28 深色系统 → 深色 DeviceDefault
        values-v29/        API 29+ 交给 DayNight 自己切
      别把 parent 写成 Theme.DeviceDefault 一个：那是深色主题，在浅色系统上会出现
      "深色控件 + 我们自己设的浅色窗口背景"这种对不上的组合。
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/vnotif_surface</item>
        <item name="android:colorBackground">@color/vnotif_surface</item>
        <item name="android:statusBarColor">@color/vnotif_surface</item>
        <item name="android:navigationBarColor">@color/vnotif_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
